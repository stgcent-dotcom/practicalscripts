local function GetUnheldBall(myRootPos, range)
if IsAnyPlayerHoldingBall() then
return nil
end
local basketballs = workspace:FindFirstChild('Basketballs')
if not basketballs then return nil end
local shortestDist = range
local closestBall = nil
for _, ball in ipairs(basketballs:GetChildren()) do
if ball:IsA('BasePart') then
local isHeld = false
local attrFolder = ball:FindFirstChild('Attributes')
if attrFolder then
local charVal = attrFolder:FindFirstChild('Character')
if charVal and charVal:IsA('ObjectValue') and charVal.Value ~= nil then
isHeld = true
end
end
if not isHeld then
local d = (ball.Position - myRootPos).Magnitude
if d < shortestDist then
shortestDist = d
closestBall = ball
end
end
end
end
return closestBall
end
