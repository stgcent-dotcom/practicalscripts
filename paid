local lastGuardState = false
local lastEnemyPos = Vector3.zero
local lastTickTime = 0
local function SetKeyInstant(key, state)
pcall(function()
if state then
VS:SendKeyEvent(true, key, false, game)
else
VS:SendKeyEvent(false, key, false, game)
end
end)
end
local function ResetMovementKeys()
if lastW then SetKeyInstant(Enum.KeyCode.W, false); lastW = false end
if lastS then SetKeyInstant(Enum.KeyCode.S, false); lastS = false end
if lastA then SetKeyInstant(Enum.KeyCode.A, false); lastA = false end
if lastD then SetKeyInstant(Enum.KeyCode.D, false); lastD = false end
end
local function ResolveGuardTarget(myRig, myRoot)
local mode = Options.GuardTargetMode and Options.GuardTargetMode.Value or 'Auto (Closest)'
local maxDist = Options.MaxGuardDist and Options.MaxGuardDist.Value or 100.0
if mode == 'Ball Carrier' then
local carrier = GetBallCarrier()
if carrier then
local root = carrier:FindFirstChild('HumanoidRootPart')
if root and (root.Position - myRoot.Position).Magnitude <= maxDist then
return root, carrier
end
end
return nil, nil
elseif mode == 'Manual Select' then
local targetName = Options.GuardManualTarget and Options.GuardManualTarget.Value
if targetName and targetName ~= "None" then
local charFolder = workspace:FindFirstChild('Characters') or workspace
for _, otherChar in ipairs(charFolder:GetChildren()) do
if otherChar ~= myRig and (otherChar.Name:lower() == targetName:lower()) then
local root = otherChar:FindFirstChild('HumanoidRootPart')
if root then return root, otherChar end
end
end
end
return nil, nil
else
local carrier = GetBallCarrier()
if carrier then
local root = carrier:FindFirstChild('HumanoidRootPart')
if root and (root.Position - myRoot.Position).Magnitude <= maxDist then
return root, carrier
end
end
local shortest = maxDist
local bestRoot, bestChar = nil, nil
local charFolder = workspace:FindFirstChild('Characters') or workspace
for _, otherChar in ipairs(charFolder:GetChildren()) do
if otherChar ~= myRig and otherChar:FindFirstChild('HumanoidRootPart') and not IsMe(otherChar.Name) then
local otherRoot = otherChar:FindFirstChild('HumanoidRootPart')
local dist = (otherRoot.Position - myRoot.Position).Magnitude
if dist < shortest then
shortest = dist
bestRoot = otherRoot
bestChar = otherChar
end
end
end
return bestRoot, bestChar
end
end
local function UpdateVisuals(targetChar, targetRoot, clampSpot)
local enabled = Toggles.ShowGuardVisuals and Toggles.ShowGuardVisuals.Value
local guardColor = Options.GuardColor and Options.GuardColor.Value or Color3.fromRGB(255, 50, 50)
local clampColor = Options.ClampColor and Options.ClampColor.Value or Color3.fromRGB(0, 255, 150)
if not enabled or not targetChar or not targetRoot then
if TargetHighlight then TargetHighlight.Enabled = false end
if TargetTracer then TargetTracer.Visible = false end
if TargetCircle then TargetCircle.Visible = false end
if ClampMarker then ClampMarker.Visible = false end
return
end
if Toggles.ShowGuardHighlight and Toggles.ShowGuardHighlight.Value then
if not TargetHighlight or not TargetHighlight.Parent then
TargetHighlight = Instance.new('Highlight')
TargetHighlight.Name = "GuardTargetHighlight"
end
TargetHighlight.Parent = targetChar
TargetHighlight.FillColor = guardColor
TargetHighlight.OutlineColor = Color3.new(1, 1, 1)
TargetHighlight.FillTransparency = 0.6
TargetHighlight.OutlineTransparency = 0.1
TargetHighlight.Enabled = true
elseif TargetHighlight then
TargetHighlight.Enabled = false
end
local cam = workspace.CurrentCamera
if not cam then return end
if TargetTracer and Toggles.ShowGuardTracer and Toggles.ShowGuardTracer.Value then
local pos, onScreen = cam:WorldToViewportPoint(targetRoot.Position)
if onScreen then
TargetTracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
TargetTracer.To = Vector2.new(pos.X, pos.Y)
TargetTracer.Color = guardColor
TargetTracer.Visible = true
else
TargetTracer.Visible = false
end
elseif TargetTracer then
TargetTracer.Visible = false
end
if TargetCircle and Toggles.ShowGuardRing and Toggles.ShowGuardRing.Value then
local pos, onScreen = cam:WorldToViewportPoint(targetRoot.Position)
if onScreen then
TargetCircle.Position = Vector2.new(pos.X, pos.Y)
TargetCircle.Radius = math.clamp(1000 / pos.Z, 10, 80)
TargetCircle.Color = guardColor
TargetCircle.Visible = true
else
TargetCircle.Visible = false
end
elseif TargetCircle then
TargetCircle.Visible = false
end
if ClampMarker and Toggles.ShowClampMarker and Toggles.ShowClampMarker.Value and clampSpot then
local pos, onScreen = cam:WorldToViewportPoint(clampSpot)
if onScreen then
ClampMarker.Position = Vector2.new(pos.X, pos.Y)
ClampMarker.Radius = math.clamp(600 / pos.Z, 4, 30)
ClampMarker.Color = clampColor
ClampMarker.Visible = true
else
ClampMarker.Visible = false
end
elseif ClampMarker then
ClampMarker.Visible = false
end
end
local function MoveTowardsWorldPos(myRootPos, targetPos)
local cam = workspace.CurrentCamera
if not cam then return end
local dir = Vector3.new(targetPos.X - myRootPos.X, 0, targetPos.Z - myRootPos.Z)
if dir.Magnitude < 0.5 then
ResetMovementKeys()
return
end
dir = dir.Unit
local camCF = cam.CFrame
local lookDir = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
local rightDir = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
local fwdAmount = dir:Dot(lookDir)
local rightAmount = dir:Dot(rightDir)
local needW = fwdAmount > 0.15
local needS = fwdAmount < -0.15
local needD = rightAmount > 0.15
local needA = rightAmount < -0.15
if needW ~= lastW then SetKeyInstant(Enum.KeyCode.W, needW); lastW = needW end
if needS ~= lastS then SetKeyInstant(Enum.KeyCode.S, needS); lastS = needS end
if needD ~= lastD then SetKeyInstant(Enum.KeyCode.D, needD); lastD = needD end
if needA ~= lastA then SetKeyInstant(Enum.KeyCode.A, needA); lastA = needA end
end
Run.RenderStepped:Connect(function()
if Library.Unloaded then return end
local myRig = Rig()
if not myRig then return end
local myRoot = myRig:FindFirstChild('HumanoidRootPart')
if not myRoot then return end
local hasBall = HasBall()
local reboundDist = Options.ReboundRange and Options.ReboundRange.Value or 60.0
local looseBall = (Toggles.AutoRebound and Toggles.AutoRebound.Value and not hasBall) and GetUnheldBall(myRoot.Position, reboundDist) or nil
local currentGuard = Toggles.AutoGuard and Toggles.AutoGuard.Value and not hasBall and not looseBall
if currentGuard ~= lastGuardState then
lastGuardState = currentGuard
SetKeyInstant(Enum.KeyCode.G, currentGuard)
elseif currentGuard then
SetKeyInstant(Enum.KeyCode.G, true)
end
if looseBall then
TargetInfo:SetText('Target Lock: Rebounding Ball!')
UpdateVisuals(nil, nil, nil)
MoveTowardsWorldPos(myRoot.Position, looseBall.Position)
return
end
if not (Toggles.SmartDefense and Toggles.SmartDefense.Value) or hasBall then
TargetInfo:SetText('Target Lock: None')
ResetMovementKeys()
UpdateVisuals(nil, nil, nil)
return
end
local targetRoot, targetChar = ResolveGuardTarget(myRig, myRoot)
if targetRoot and targetChar then
TargetInfo:SetText('Target Lock: ' .. tostring(targetChar.Name))
local now = tick()
local dt = math.clamp(now - lastTickTime, 0.001, 0.1)
lastTickTime = now
local enemyPos = targetRoot.Position
local enemyVel = (enemyPos - lastEnemyPos) / dt
lastEnemyPos = enemyPos
local predMult = Options.PredictionStrength.Value
local predictedEnemyPos = enemyPos + (Vector3.new(enemyVel.X, 0, enemyVel.Z) * predMult)
local goalPos = GetTargetGoalPos(myRoot.Position)
local enemyToGoal = (goalPos - predictedEnemyPos)
local distToGoal = enemyToGoal.Magnitude
local dirToGoal = (distToGoal > 1) and enemyToGoal.Unit or Vector3.new(0, 0, 1)
local studGap = Options.StudGap.Value
local clampSpot = predictedEnemyPos + (dirToGoal * math.min(studGap, distToGoal))
clampSpot = Vector3.new(clampSpot.X, myRoot.Position.Y, clampSpot.Z)
UpdateVisuals(targetChar, targetRoot, clampSpot)
MoveTowardsWorldPos(myRoot.Position, clampSpot)
else
TargetInfo:SetText('Target Lock: Out of Range')
ResetMovementKeys()
UpdateVisuals(nil, nil, nil)
end
end)
if Toggles.HeightExtender then
Toggles.HeightExtender:OnChanged(function() Height(Toggles.HeightExtender.Value) end)
end
if Options.HeightValue then
Options.HeightValue:OnChanged(function()
if Toggles.HeightExtender and Toggles.HeightExtender.Value then Height(true) end
end)
end
if Toggles.AutoGuard then
Toggles.AutoGuard:OnChanged(function()
if not Toggles.AutoGuard.Value then
SetKeyInstant(Enum.KeyCode.G, false)
lastGuardState = false
end
end)
end
Plr.CharacterAdded:Connect(function()
task.wait(1); tracked, baseHip = nil, nil
if Toggles.HeightExtender and Toggles.HeightExtender.Value then Height(true) end
end)
task.spawn(function()
while true do
task.wait(0.25)
if Library.Unloaded then break end
if Toggles.HeightExtender and Toggles.HeightExtender.Value then Height(true) end
end
end)
