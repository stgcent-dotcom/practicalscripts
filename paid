function tObj:OnChanged(cb) table.insert(self.ChangedCallbacks, cb) end
local ft = tab:AddToggle(id, { Title = title, Default = default, Description = tooltip })
ft:OnChanged(function(v)
tObj.Value = v
for _, cb in ipairs(tObj.ChangedCallbacks) do task.spawn(cb, v) end
end)
Toggles[id] = tObj
return tObj
end
